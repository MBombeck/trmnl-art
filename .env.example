# Admin auth — REQUIRED in production, protected routes are 503 without it.
# Browser: Login-Seite /login (Passwort oder Passkey) -> Session-Cookie.
# APIs: HTTP Basic bleibt als curl-Fallback erhalten.
ADMIN_USERNAME=marc
ADMIN_PASSWORD=

# Optional: dedizierter HMAC-Key fuer Session-Cookies.
# Ohne SESSION_SECRET wird der Key aus ADMIN_PASSWORD abgeleitet
# (Passwort-Rotation loggt dann alle Sessions aus).
SESSION_SECRET=

# WebAuthn/Passkeys: RP-ID + erlaubte Origins (kommasepariert)
WEBAUTHN_RP_ID=bombeck.io
WEBAUTHN_ORIGINS=https://trmnl.bombeck.io,https://trmnl-art.bombeck.io

# TRMNL webhook UUID (from trmnl.com private plugin settings)
TRMNL_WEBHOOK_UUID=3b607cf6-508d-4480-9229-17edca1f69ee

# Art source: "goat-art" (default), "rijksmuseum", "nasa", or "mixed"
ART_SOURCE=goat-art

# Gemini API key (for goat-art on-demand generation via Imagen 4 Ultra)
GEMINI_API_KEY=

# NASA API key (get free key at https://api.nasa.gov or use DEMO_KEY)
NASA_API_KEY=DEMO_KEY

# Schedule — single daily push (hours in Europe/Berlin timezone)
GOAT_ART_HOUR=6
GOAT_ART_MINUTE=0
RIJKSMUSEUM_HOUR=5
NASA_HOUR=12
TZ=Europe/Berlin

# App URL (how TRMNL reaches this service)
APP_URL=https://trmnl-art.bombeck.io

# Data directory (for persistent storage)
DATA_DIR=/app/data

# Port
PORT=8000

# Imagen-Modell (Standard ist guenstiger als Ultra und fuer 800x480 voellig ausreichend)
# IMAGEN_MODEL=imagen-4.0-generate-001
